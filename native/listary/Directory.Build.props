<Project>
  <PropertyGroup Condition="'$(AuraExplorerBuildRoot)' != ''">
    <BaseIntermediateOutputPath>$(AuraExplorerBuildRoot)\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(AuraExplorerBuildRoot)\$(MSBuildProjectName)\bin\</BaseOutputPath>
  </PropertyGroup>
  <Target Name="RequireExternalBuildRoot" BeforeTargets="Restore;PrepareForBuild">
    <Error Condition="'$(AuraExplorerBuildRoot)' == ''" Text="Set AuraExplorerBuildRoot to an absolute build/cache directory outside the source tree." />
  </Target>
</Project>
